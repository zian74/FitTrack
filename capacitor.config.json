{
  "appId": "fr.fittrack.app",
  "appName": "FitTrack",
  "webDir": "public",
  "bundledWebRuntime": false,
  "backgroundColor": "#f4f7fa",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#1F4E79",
      "showSpinner": false
    }
  }
}
